{
  "entities": {
    "User": {
      "title": "User",
      "description": "Represents a buyer or seller in the Auto Parts C2C marketplace",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "createdAt": { "type": "integer" },
        "isBlocked": { "type": "boolean" }
      },
      "required": ["id", "name", "email", "phone"]
    },
    "SparePart": {
      "title": "SparePart",
      "description": "Represents a car spare part listing in India",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "carBrand": { "type": "string" },
        "carModel": { "type": "string" },
        "category": { "type": "string" },
        "partName": { "type": "string" },
        "condition": { "type": "string", "enum": ["Brand New", "Like New", "Used (Good)", "For Scrap/Spares"] },
        "location": { "type": "string" },
        "state": { "type": "string" },
        "district": { "type": "string" },
        "contactName": { "type": "string" },
        "contactPhone": { "type": "string" },
        "imageUrl": { "type": "string" },
        "sellerId": { "type": "string" },
        "sellerEmail": { "type": "string" },
        "createdAt": { "type": "integer" }
      },
      "required": ["id", "title", "description", "price", "carBrand", "carModel", "category", "condition", "location", "contactName", "contactPhone", "imageUrl", "sellerId", "sellerEmail", "createdAt"]
    },
    "Chat": {
      "title": "Chat",
      "description": "Represents a conversation room between a buyer and seller regarding a specific car part",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "partId": { "type": "string" },
        "partTitle": { "type": "string" },
        "partImageUrl": { "type": "string" },
        "partPrice": { "type": "number" },
        "buyerId": { "type": "string" },
        "buyerName": { "type": "string" },
        "sellerId": { "type": "string" },
        "sellerName": { "type": "string" },
        "lastMessageText": { "type": "string" },
        "lastMessageAt": { "type": "integer" },
        "lastSenderId": { "type": "string" }
      },
      "required": ["id", "partId", "partTitle", "partImageUrl", "partPrice", "buyerId", "buyerName", "sellerId", "sellerName", "lastMessageAt"]
    },
    "Message": {
      "title": "Message",
      "description": "An individual message within a conversation room",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "senderId": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "integer" },
        "status": { "type": "string", "enum": ["sent", "delivered", "read"] }
      },
      "required": ["senderId", "text", "createdAt"]
    },
    "SellerReview": {
      "title": "SellerReview",
      "description": "Represents a rating and review submitted for a seller by a buyer",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sellerId": { "type": "string" },
        "buyerId": { "type": "string" },
        "buyerName": { "type": "string" },
        "rating": { "type": "integer" },
        "comment": { "type": "string" },
        "partId": { "type": "string" },
        "partTitle": { "type": "string" },
        "createdAt": { "type": "integer" }
      },
      "required": ["id", "sellerId", "buyerId", "buyerName", "rating", "comment", "createdAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "Represents an unread chat notification for a user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "chatId": { "type": "string" },
        "recipientId": { "type": "string" },
        "senderId": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "integer" },
        "read": { "type": "boolean" },
        "partTitle": { "type": "string" },
        "partPrice": { "type": "number" },
        "partImageUrl": { "type": "string" },
        "buyerId": { "type": "string" },
        "buyerName": { "type": "string" },
        "sellerId": { "type": "string" },
        "sellerName": { "type": "string" }
      },
      "required": ["id", "chatId", "recipientId", "senderId", "text", "createdAt", "read", "partTitle", "partPrice", "buyerId", "buyerName", "sellerId", "sellerName"]
    },
    "Favorite": {
      "title": "Favorite",
      "description": "Represents a user's favorited car spare part listing",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "partId": { "type": "string" },
        "createdAt": { "type": "integer" }
      },
      "required": ["id", "userId", "partId", "createdAt"]
    },
    "AppVersionConfig": {
      "title": "AppVersionConfig",
      "description": "App version configuration document for auto update system",
      "type": "object",
      "properties": {
        "latestVersion": { "type": "string" },
        "minimumSupportedVersion": { "type": "string" },
        "forceUpdate": { "type": "boolean" },
        "apkDownloadUrl": { "type": "string" },
        "releaseNotes": { "type": "string" },
        "releaseDate": { "type": "string" }
      },
      "required": ["latestVersion", "minimumSupportedVersion", "forceUpdate", "apkDownloadUrl", "releaseNotes", "releaseDate"]
    },
    "TaxonomyConfig": {
      "title": "TaxonomyConfig",
      "description": "Taxonomy documents like categories, brands, subcategories, models, states, districts, cities, locations",
      "type": "object",
      "properties": {
        "list": { "type": "array" },
        "map": { "type": "object" }
      }
    },
    "Announcement": {
      "title": "Announcement",
      "description": "System broadcast announcement sent by admins",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "integer" }
      },
      "required": ["title", "text", "createdAt"]
    },
    "Banner": {
      "title": "Banner",
      "description": "Represents a promotional hero carousel banner",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "tag": { "type": "string" },
        "imageUrl": { "type": "string" },
        "public_id": { "type": "string" },
        "imagePublicId": { "type": "string" },
        "targetLink": { "type": "string" },
        "active": { "type": "boolean" },
        "activeStatus": { "type": "boolean" },
        "order": { "type": "integer" },
        "orderRank": { "type": "integer" },
        "createdAt": { "type": "integer" },
        "updatedAt": { "type": "integer" }
      },
      "required": ["title", "imageUrl", "createdAt"]
    },
    "Follow": {
      "title": "Follow",
      "description": "Represents a social follow relationship between users",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "followerId": { "type": "string" },
        "followingId": { "type": "string" },
        "followerName": { "type": "string" },
        "createdAt": { "type": "integer" }
      },
      "required": ["followerId", "followingId", "createdAt"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Collection of user account data"
    },
    "products/listings/items/{partId}": {
      "schema": { "$ref": "#/entities/SparePart" },
      "description": "Collection of car spare part listings under products/listings"
    },
    "products/{productId}": {
      "schema": { "$ref": "#/entities/SparePart" },
      "description": "Collection of car spare part listings under root products collection"
    },
    "banners/{bannerId}": {
      "schema": { "$ref": "#/entities/Banner" },
      "description": "Hero carousel banners stored in Firestore"
    },
    "follows/{followId}": {
      "schema": { "$ref": "#/entities/Follow" },
      "description": "Social follower relationships between marketplace users"
    },
    "chats/{chatId}": {
      "schema": { "$ref": "#/entities/Chat" },
      "description": "Active C2C buyer-seller marketplace chat rooms"
    },
    "chats/{chatId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/Message" },
      "description": "Individual messages inside a chat room"
    },
    "seller_reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/SellerReview" },
      "description": "Ratings and written reviews for marketplace sellers"
    },
    "notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "Unread message notifications for buyers and sellers"
    },
    "favorites/{favoriteId}": {
      "schema": { "$ref": "#/entities/Favorite" },
      "description": "Collection of user's favorited spare parts"
    },
    "app_config/{configId}": {
      "schema": { "$ref": "#/entities/AppVersionConfig" },
      "description": "Collection storing application configuration documents like version info"
    },
    "config/{docName}": {
      "schema": { "$ref": "#/entities/TaxonomyConfig" },
      "description": "Taxonomy system configurations managed by admins"
    },
    "announcements/{announcementId}": {
      "schema": { "$ref": "#/entities/Announcement" },
      "description": "System announcements broadcasted to users"
    }
  }
}
